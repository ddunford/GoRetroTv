# GoRetroTV — every environment variable the binary reads.
#
# Copy this file to `.env` and edit it. `.env` is gitignored; this one is committed, so it carries
# variable NAMES and harmless example values only. Never a real secret, here or in any other file
# under version control.
#
# This list is not maintained by hand. `internal/config.Config` declares each setting with an `env`
# struct tag, and a test walks that struct and fails if a variable exists in one place and not the
# other. Adding a setting to the struct without adding it here turns the suite red, which is the
# point: a variable the binary reads but nobody documented is how a deployment acquires an
# undeclared dependency on a default.
#
# `./ctl.sh` loads `.env` before running anything, and `docker compose` reads it for the compose
# file's own substitutions.

# --- Required ---------------------------------------------------------------------------------
# No default and no guess. The binary refuses to start without these and names the ones missing.

# Which deployment this is: development | production.
# Required because there is no safe guess. A box that quietly decided it was a development box is
# the failure that announces itself last.
GORETROTV_ENV=development

# Where the flash images and their MANIFEST.md live. Every image is verified against that manifest
# and the binary refuses to start on a mismatch.
#
# Required, and for a sharper reason than the one above: the manifest is read from THIS directory,
# so the checksum guard cannot notice a wrong directory — a different firmware set arrives with its
# own manifest and verifies perfectly against itself. Silently running a different ROM is the exact
# failure that verification exists to prevent, and it is invisible to every check downstream of
# this value, so the value has to be stated rather than guessed.
#
# A relative default would be worse than none: it resolves against the process's working directory,
# so the same binary finds different ROMs depending on where it was started. Prefer an absolute
# path. In the container this is /firmware, which is where docker-compose.yml mounts it read-only.
#
# THE IMAGES ARE NOT REDISTRIBUTABLE. They are Pace's, they are gitignored, and a clone is inert
# until someone supplies them. See firmware/MANIFEST.md.
GORETROTV_FIRMWARE_DIR=./firmware

# Optional private machine snapshot. Leave empty to cold boot from the reset vector.
GORETROTV_SNAPSHOT_PATH=

# Static page directory, including dist/ from npm run build:web.
GORETROTV_WEB_DIR=web

# --- Optional ---------------------------------------------------------------------------------
# The values shown are the defaults compiled into `config.Defaults`. Leave a line out and you get
# the default; set it and you get what you set.

# The name that labels every log line.
GORETROTV_SERVICE_NAME=goretrotv

# What the HTTP server listens on.
#
# The default binds the loopback interface, and that is a security decision rather than a
# convenience one (CLAUDE.md -> Deployment and access): the gdb stub and the instrument endpoints
# are developer surfaces, this is a public demo host, and loopback is the one real control over
# them. Do not widen it to `:8099` or `0.0.0.0:8099` on a host. A container is the exception — it
# binds all interfaces inside and the compose port mapping publishes it to loopback only.
GORETROTV_HTTP_ADDR=127.0.0.1:8099

# Container-only escape hatch for the all-interface bind above. Native runs leave this false.
# The committed compose file sets it literally and maps the port to host loopback.
GORETROTV_BIND_ALL_INTERFACES=false

# Log threshold: debug | info | warn | error. An unrecognised value is refused rather than
# rounded to info, because a process logging less than its operator asked for looks identical to a
# process with nothing to say.
GORETROTV_LOG_LEVEL=info

# Log encoding: json | text. JSON everywhere that anything will be queried — every question asked
# of this program is "what was the machine doing at instruction N", and that is a query.
GORETROTV_LOG_FORMAT=json

# Mount the pprof endpoints. A developer surface: off by default, and reaching it needs both this
# flag and a listener the caller can get to.
GORETROTV_ENABLE_PPROF=false

# --- The modelled broadcast ---------------------------------------------------------------------

# The editable schedule the multiplex transmits. Empty means transmit nothing, which is a supported
# way to run: the box boots and its menus work, and the guide says there is no schedule
# information — which is what a real box off the dish says.
GORETROTV_LISTINGS_PATH=listings.json

# The Sky/OpenTV Huffman dictionary the title sections are compressed with. THIRD-PARTY DATA, not
# redistributable and not in git — see dictionaries/MANIFEST.md. Without it the server refuses to
# broadcast and says so, rather than running a silent multiplex that looks exactly like having no
# schedule.
GORETROTV_DICTIONARY_PATH=dictionaries/skyuk.dict

# The in-world day, as a Modified Julian Date. 51171 is Christmas Eve 1998 — in the subscribing set
# below, and in GMT, so the schedule’s local times and the wire’s UTC coincide.
#
# It is pinned rather than following the clock because of a measured defect: this box programs a
# listings filter on only three of the eight days in the title-PID rotation (MJD mod 8 in 1, 3 or
# 6), so a freely chosen day leaves the guide empty five times in eight with no error anywhere.
# Tracked as TASK-6.13; when it is understood this becomes a real clock and this variable goes.
GORETROTV_BROADCAST_DAY_MJD=51171

# --- Read by ./ctl.sh, not by the binary --------------------------------------------------------
# Listed for the operator's benefit, because a variable ctl.sh reads and nobody documented is the
# same failure one layer out. These are not on the Config struct, so the completeness test carries
# them in a short explicit allowlist — adding another one here without declaring it there turns the
# suite red rather than quietly widening the exemption.

# The host port `./ctl.sh up` publishes the container on, always bound to 127.0.0.1. 8099 rather
# than 8080 because 8080 is occupied on the development host.
GORETROTV_PORT=8099
