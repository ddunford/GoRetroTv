#!/usr/bin/env bash
# Delegates to beads.
#
# core.hooksPath points at .githooks, so git no longer looks in .beads/hooks — this file is what
# keeps beads' own pre-push hook running. It is not a placeholder: without it the tracker
# silently stops doing its half of the work, and a tracker that quietly stops is worse than one
# that errors, because the issue graph goes on looking authoritative.
#
# Project-specific pre-push checks belong above the delegation, not instead of it.
set -uo pipefail

if [ -x .beads/hooks/pre-push ]; then
    exec .beads/hooks/pre-push "$@"
fi
exit 0
