# THE FIRMWARE IS NOT REDISTRIBUTABLE. The flash images and the decompressed application image are
# Pace's, not ours. They are required to run anything here, they are recorded in
# firmware/MANIFEST.md with their sizes and checksums, and they must never be committed or baked
# into an image. A clone is inert until someone supplies them.
firmware/*.bin

# The operator's environment file. .env.example is committed and carries variable NAMES and
# harmless examples; the real one never is.
.env
.env.local
.env.*.local
!.env.example

# Build output, caches, and the Go binary
/bin/
/dist/
/web/dist/
*.test
__pycache__/
.playwright-mcp/
test-results/
node_modules/

# Machine snapshots and recorded traces: reproducible, often large, and never reviewable
/snapshots/
/traces/
/.artifacts/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Sky/OpenTV dictionaries other than the attributed GPL-2.0 `skyuk.dict` may have
# different provenance. Keep unknown local dictionaries out of the repository.
/dictionaries/*.dict
!/dictionaries/skyuk.dict

# Operator programme media can be large and may carry its own redistribution terms. Keep the
# provenance manifest, but mount the actual files at runtime rather than committing or baking them.
/media/*
!/media/MANIFEST.md

# The Ghidra analysis database and the staged application image: derived, large, and the
# image is the non-redistributable firmware under another name.
/ghidra/
