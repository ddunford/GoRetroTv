{
  "version": 3,
  "raster": {
    "width": 720,
    "height": 576
  },
  "messages": {
    "palette": {
      "direction": "server",
      "fields": {
        "epoch": "uint64",
        "rgb": "base64",
        "alpha": "base64"
      }
    },
    "frame": {
      "direction": "server",
      "fields": {
        "seq": "uint64",
        "x": "uint32",
        "y": "uint32",
        "w": "uint32",
        "h": "uint32",
        "epoch": "uint64",
        "pixels": "base64"
      }
    },
    "state": {
      "direction": "server",
      "fields": {
        "phase": [
          "booting",
          "flash-check",
          "channel-list",
          "ready",
          "halted"
        ],
        "reason": "string"
      }
    },
    "media": {
      "direction": "server",
      "fields": {
        "active": "uint8",
        "service": "string",
        "programme": "string",
        "source": "string"
      }
    },
    "key": {
      "direction": "client",
      "fields": {
        "raw": "uint8",
        "source": "uint8"
      }
    },
    "reset": {
      "direction": "client",
      "fields": {}
    }
  }
}
